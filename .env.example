# Copy this file to .env and paste your key from app.gnani.ai/voice
GNANI_API_KEY=paste-your-key-here

# Optional: Gnani models / voice
# PRISMA_MODEL=prisma-v3.0      # leave empty ("PRISMA_MODEL=") to use Prisma v2.5
# TIMBRE_MODEL=timbre-v3.0
# TIMBRE_VOICE=Shivani          # v3.0 female: Shivani, Lakshmi, Kalpana... male: Avinash, Shubham, Prakash...
# VAD_MIN_SILENCE_MS=           # live mode: how long a pause ends a phrase (Gnani default if empty)

# Optional: an LLM for follow-up questions that kb.py doesn't cover.
# It may ONLY answer from that scheme's verified facts; otherwise the app says "I don't know".
# Any OpenAI-compatible endpoint works, e.g. xAI (Grok API, paid): https://api.x.ai/v1
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_API_KEY=
# LLM_MODEL=

# PORT=5000
